<Window x:Class="ShareU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShareU"
        mc:Ignorable="d"
        Title="ShareU - File Transfer" 
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa"
        FontFamily="Segoe UI, sans-serif"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Create a linear gradient brush for the primary gradient -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4361ee" Offset="0"/>
            <GradientStop Color="#3a0ca3" Offset="1"/>
        </LinearGradientBrush>

        <!-- Create a linear gradient brush for the accent gradient -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4cc9f0" Offset="0"/>
            <GradientStop Color="#4361ee" Offset="1"/>
        </LinearGradientBrush>

        <!-- Define the shadow effects -->
        <DropShadowEffect x:Key="ButtonShadowEffect" BlurRadius="12" ShadowDepth="2" 
                          Opacity="0.25" Color="#000000"/>

        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="24" ShadowDepth="4" 
                          Opacity="0.06" Color="#000000"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" 
                                                  Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <TranslateTransform X="0" Y="-2"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3a0ca3"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <TranslateTransform X="0" Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#6c757d"/>
                                <Setter Property="Foreground" Value="#dedede"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#ef476f"/>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#d43b63"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#eeeeee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" 
                                    Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QRCodeCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#eeeeee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" 
                                    Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="30,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4361ee" Offset="0"/>
                    <GradientStop Color="#3a0ca3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="ShareU" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                <TextBlock Text="Secure Local Network File Transfer" FontSize="16" Foreground="White" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column - Status and Controls -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                <!-- Status Section -->
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="#ef476f" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock" Text="Server Stopped" FontSize="20" FontWeight="SemiBold" Foreground="#212b36"/>
                        </StackPanel>
                        <TextBlock x:Name="ServerUrlBlock" Text="" Margin="0,16,0,0" TextAlignment="Center" 
                                 Foreground="#4361ee" FontFamily="Consolas" FontSize="16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24">
                    <Button x:Name="StartServerButton" Content="Start Share" Style="{StaticResource ModernButton}" Click="StartServerButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏵" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button x:Name="StopServerButton" Content="Stop Share" Style="{StaticResource StopButton}" IsEnabled="False" Click="StopServerButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◼" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Center Column - QR Code -->
            <Border Grid.Column="1" Style="{StaticResource QRCodeCard}" Width="320" Margin="0,0,24,0">
                <StackPanel>
                    <TextBlock Text="Scan QR Code" FontSize="24" FontWeight="SemiBold" Foreground="#212b36" Margin="0,0,0,20" TextAlignment="Center"/>
                    <Border x:Name="QRCodeContainer" Background="White" Width="240" Height="240" HorizontalAlignment="Center">
                        <Image x:Name="QRCodeImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="QRCodeUrl" Text="" Margin="0,20,0,0" TextAlignment="Center" 
                             Foreground="#4361ee" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                    <Button x:Name="CopyUrlButton" Content="Copy URL" Style="{StaticResource ModernButton}" 
                            Margin="0,20,0,0" Click="CopyUrlButton_Click" Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Column - Empty for balance -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="How to Use" FontSize="24" FontWeight="SemiBold" Foreground="#212b36" Margin="0,0,0,16"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="1. Click &quot;Start Share&quot; to begin file sharing" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="2. Scan the QR code with your mobile device"/>
                            <LineBreak/>
                            <Run Text="3. Or copy the URL to share with others"/>
                            <LineBreak/>
                            <Run Text="4. Upload and download files securely"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#f8f9fa" Padding="20,12">
            <TextBlock Text="ShareU v1.0 • Secure Local Network File Transfer" 
                     HorizontalAlignment="Center" Foreground="#6c757d" FontSize="12"/>
        </Border>
    </Grid>
</Window>