<Window x:Class="ShareU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShareU"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ShareU - File Transfer" 
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/resources/app_icon.png"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#33FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A2E" Offset="0"/>
                <GradientStop Color="#FF16213E" Offset="0.5"/>
                <GradientStop Color="#FF0F3460" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="20,10,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/resources/app_icon.png" Width="28" Height="28" Margin="0,0,10,0" />
                    <TextBlock Text="ShareU" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Click="MinimizeButton_Click" Padding="0" Width="30" Height="30">
                        <materialDesign:PackIcon Kind="WindowMinimize" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Click="CloseButton_Click" Padding="0" Width="30" Height="30">
                        <materialDesign:PackIcon Kind="WindowClose" Foreground="#E94560" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column - Status and Controls -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource GlassCard}" Padding="30">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#E94560" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="4"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusTextBlock" Text="Offline" FontSize="24" FontWeight="Light" Foreground="White" />
                            </StackPanel>
                            
                            <Border x:Name="ServerUrlContainer" Background="#11FFFFFF" CornerRadius="10" Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ServerUrlBlock" Text="" Padding="15" TextAlignment="Center" 
                                         Foreground="#E94560" FontFamily="Consolas" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Button x:Name="StartServerButton" Content="START SHARING" 
                                Foreground="White"
                                Background="#E94560"
                                BorderThickness="0"
                                materialDesign:ButtonAssist.CornerRadius="25" 
                                Width="160" Height="50" FontSize="14" FontWeight="Bold">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#E94560" Opacity="0.4" ShadowDepth="0"/>
                            </Button.Effect>
                        </Button>
                        <Button x:Name="StopServerButton" Content="STOP" 
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White"
                                BorderBrush="#44FFFFFF"
                                materialDesign:ButtonAssist.CornerRadius="25" 
                                Margin="15,0,0,0" Width="100" Height="50" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Column - QR Code -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Width="320" Margin="0,0,20,0" Padding="30">
                    <StackPanel>
                        <TextBlock Text="REMOTELY CONNECT" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,20" TextAlignment="Center" />
                        <Border Background="White" CornerRadius="15" Padding="15" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0"/>
                            </Border.Effect>
                            <Image x:Name="QRCodeImage" Width="200" Height="200" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="QRCodeUrl" Text="" Margin="0,20,0,0" TextAlignment="Center" 
                                 Foreground="White" Opacity="0.6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        <Button x:Name="CopyUrlButton" Content="COPY URL" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#E94560"
                                Margin="0,15,0,0" Click="CopyUrlButton_Click" Visibility="Collapsed">
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Column -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Style="{StaticResource GlassCard}" Padding="30">
                        <StackPanel>
                            <TextBlock Text="INSTRUCTIONS" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,20"/>
                            <StackPanel>
                                <TextBlock Text="1. Start the server" Foreground="White" Margin="0,0,0,10" Opacity="0.8"/>
                                <TextBlock Text="2. Scan QR or share URL" Foreground="White" Margin="0,0,0,10" Opacity="0.8"/>
                                <TextBlock Text="3. Drag &amp; Drop files here" Foreground="White" Margin="0,0,0,10" Opacity="0.8"/>
                                <TextBlock Text="4. Access from any device" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource GlassCard}" Margin="0,20,0,0" Padding="20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Security" Foreground="#06D6A0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Encrypted P2P Transfer" Foreground="#06D6A0" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="ShareU • Design by Antigravity" 
                     HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.3" Foreground="White" FontSize="10"/>
        </Grid>
    </Border>
</Window>